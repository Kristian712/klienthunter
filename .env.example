# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/klienthunter"

# Podepisuje přihlašovací tokeny. POVINNÉ — aplikace bez něj nenastartuje, protože
# dřívější fallback byl veřejně čitelný v tomhle repozitáři. Vygeneruj si vlastní:
#   openssl rand -base64 48
JWT_SECRET=""

# Sůl pro hashování IP adres u anonymní ukázky. Když chybí, použije se JWT_SECRET.
# Vlastní hodnota je lepší: hash IP se pak nedá zpětně spojit s podpisovým klíčem.
#   openssl rand -base64 32
IP_HASH_SALT=""

# Zdroje dat (ARES, ARES-RŽP, ADIS DPH, OpenStreetMap) jsou veřejné a bez klíče.

# Vyhledávač jako poslední pokus, když se doména z názvu firmy odvodit nedá.
# Nepovinné: bez klíče se aplikace chová stejně jako dosud, jen u zhruba pětiny firem s webem
# skončí verdikt „web nemá" místo „web má". Brave: $5 za 1 000 dotazů, měsíčně kredit $5
# (https://brave.com/search/api/, ověřeno 11. 9. 2026). Ptáme se jen na firmy, u kterých domény z názvu selhaly.
BRAVE_SEARCH_API_KEY=""
# Vyhledávač se použije, jen když je klíč a zároveň WEB_SEARCH_ENABLED=1 (viz src/lib/sources/web-search.ts).
WEB_SEARCH_ENABLED=""
# Strop dotazů na jedno celé hledání, přes všechny fáze (výchozí 100), a rozestup mezi nimi v ms (výchozí 1100).
MAX_WEB_SEARCHES="100"
WEB_SEARCH_GAP_MS="1100"
# Tvrdý strop dotazů za posledních 31 dní pro celou aplikaci (výchozí 900). Výš než 1000 se nepustí:
# to je celý měsíční kredit $5. Po vyčerpání appka tiše hledá bez vyhledávače (verdikt „nevíme").
WEB_SEARCH_MONTHLY_LIMIT="900"

# Meta Knihovna reklam (Ad Library API) — kdo v okolí platí za reklamu. Bezplatné, ale vyžaduje
# osobně ověřenou totožnost: 1) facebook.com/ID, 2) účet na developers.facebook.com, 3) aplikace,
# 4) token s právem na ads_archive (Graph API Explorer → Generate Access Token; dlouhodobý token
# vydrží 60 dní, pak vyměnit). Bez tokenu jsou filtry „Inzeruje na Meta" v UI zamčené.
META_AD_LIBRARY_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (předplatné PRO a BUSINESS) ──────────────────────────────────────
# Nic z toho nesmí začínat NEXT_PUBLIC_ — jsou to tajemství serveru.
# Klíč: Developers → API keys. Radši omezený klíč (rk_…) s právy jen na Customers,
# Checkout Sessions, Subscriptions a Billing Portal než plný sk_…
STRIPE_SECRET_KEY=""
# Podpis webhooku: Developers → Webhooks → endpoint …/api/stripe/webhook → Signing secret (whsec_…).
# Lokálně ho vypíše `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""
# ID cen (price_…) z Product catalog. Jeden produkt na tarif, měsíční cena v CZK.
# Testovací a ostrý účet mají jiná ID — proto jsou v prostředí, ne v kódu.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
