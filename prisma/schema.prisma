generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  plan             Plan      @default(FREE)
  isAdmin          Boolean   @default(false)
  isVip            Boolean   @default(false)
  accessExpiresAt  DateTime?
  stripeCustomerId String?
  /// Aktivní předplatné ve Stripe. Zapisuje ho jedině webhook — podle něj se pozná, že
  /// uživatel má komu psát do portálu. NULL = nikdy nic nekoupil nebo předplatné skončilo.
  stripeSubscriptionId String?   @unique
  /// Které ceny (tedy kterého tarifu) se předplatné týká. Jen pro dohledání ve Stripe.
  stripePriceId    String?
  /// Do kdy je zaplacené období. Informativní: `plan` řídí webhook, ne tohle datum.
  currentPeriodEnd DateTime?
  /// Stav předplatného ze Stripe: `none` | `trialing` | `active` | `past_due` | `canceled`.
  /// Přístup řídí `plan` — tohle je pro uživatele: kolik dní zbývá ze zkušebního období
  /// a jestli mu neprošla platba. Dvě různé otázky, dvě různá pole.
  subscriptionStatus String  @default("none")
  /// Konec zkušebního období, dokud běží.
  trialEndsAt      DateTime?
  // Sloupce `brevoApiKey` a `brevoSenderEmail` byly odstraněny. Aplikace přestala odesílat
  // poštu ve Vlně 2, takže se od té doby jen držel cizí API klíč, který nic nedělal —
  // to je porušení minimalizace údajů (čl. 5 odst. 1 písm. c) GDPR) a zbytečné riziko.

  // ── Onboarding profile ────────────────────────────────────────────────────
  // What the user sells, who they sell it to and where. Collected once after
  // registration so every later visit is one click, and used to rank results:
  // see targetFilters below and src/lib/lead-score.ts.
  //
  // An id from PROFESSIONS in src/lib/profile.ts, or 'other'.
  profession       String?
  /// Původní odpověď před sloučením profesí do šesti profilů (12. 9. 2026): `accounting`,
  /// `legal`, `photo`, … Zůstává, aby se dalo dohledat, kdo si vybral účetnictví a kdo právo,
  /// i když oba dnes spadají do jednoho profilu. Nový účet sem dostane totéž, co do `profession`.
  professionRaw    String?
  /// Druhá otázka dotazníku (jen u profilů, které ji mají): id volby z `followUp` v profile.ts.
  clientType       String?
  // Free text, the only thing we have when profession is 'other'.
  professionText   String?
  // The trade of the firms they are looking for — feeds the search query.
  targetIndustry   String?
  targetRegion     String?
  /// Denní dávka: nejmladší datum vzniku, které uživatel v kartě „Nové firmy v kraji" už viděl.
  /// Firmy s pozdějším vznikem jsou „nové od minule". Datum, ne čas návštěvy — index se plní
  /// dvakrát měsíčně a čas návštěvy by neřekl nic.
  digestFoundedAt  DateTime?
  /// Webhook pro Make/Zapier: kam poslat firmy po doběhnutí hledání (jen https). Viz lib/webhook.ts.
  webhookUrl       String?
  /// Tajemství pro podpis těla (HMAC-SHA256). Vzniká s adresou, uživatel ho vidí v profilu.
  webhookSecret    String?
  targetCity       String?
  // Ids from LEAD_FILTERS. The share of these a firm meets is its score, so an
  // empty list is meaningful: it means "score by the neutral default".
  targetFilters    String[] @default([])
  // Set once the modal has been answered *or* skipped, so we never nag twice.
  onboardedAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  searches         Search[]
  jobs             SearchJob[]
  claims           Claim[]
  leadTags         LeadTag[]
  savedResults     SavedResult[]
  createdCodes     InviteCode[] @relation("CreatedCodes")
  usedCode         InviteCode[] @relation("UsedCode")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

/// Jedno hledání = jeden běh. Uložené hledání je běh se jménem; další spuštění téže kombinace
/// jsou běhy se `savedId` ukazujícím na ten pojmenovaný „kořen". „Co je nové od minule" se
/// počítá z řádků posledního běhu, jejichž firma v žádném dřívějším běhu kořene nebyla.
model Search {
  id        String   @id @default(cuid())
  userId    String
  query     String
  region    String
  /// Jméno, které dal uživatel. Vyplněné jen u kořene uloženého hledání.
  name      String?
  /// Uložená kombinace filtrů (id z lead-filters.ts) a scénář — obnoví se při otevření.
  filters   String[] @default([])
  scenario  String?
  /// Okresy (LAU 1) uvnitř kraje, když uživatel zúžil výběr ve skládačce. Prázdné = celý kraj.
  districts String[] @default([])
  /// Kořen (pojmenované hledání), ke kterému tenhle běh patří. NULL = samostatný běh nebo kořen.
  savedId   String?
  /// Kdy uživatel kořen naposledy otevřel — od toho se počítá „nové od minule".
  lastOpenedAt DateTime?
  /// Odkud uložené hledání je: `profile` = výchozí kombinace z dotazníku po registraci,
  /// `user` = uživatel ji upravil nebo založil sám. Jakmile je `user`, profil do ní už nesahá.
  origin    String?
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  results BusinessResult[]
  job     SearchJob?
  saved   Search?          @relation("SavedRuns", fields: [savedId], references: [id], onDelete: SetNull)
  runs    Search[]         @relation("SavedRuns")

  @@index([userId, savedId, createdAt])
}

/// Jedno hledání běžící na pozadí.
///
/// Do teď se hledání odbývalo v jednom HTTP požadavku: uživatel čekal 50 sekund s otevřenou
/// kartou a když ji zavřel, přišel o všechno. Tenhle řádek je to, co po požadavku zůstane —
/// route ho založí, vrátí jeho id a práce pokračuje mimo odpověď (`waitUntil`).
///
/// Počítadla se aktualizují průběžně, po dávkách, ne až na konci. Když job spadne v půlce,
/// zapsané firmy zůstanou a `error` řekne proč — což je celý smysl toho, že tu ta tabulka je.
model SearchJob {
  id             String    @id @default(cuid())
  userId         String
  /// Hledání, do kterého se zapisují výsledky. Zakládá se rovnou s jobem, aby export fungoval
  /// i nad rozpracovaným během.
  searchId       String    @unique
  /// `queued` | `running` | `paused` | `done` | `failed`
  ///
  /// `paused` znamená „došel čas jedné invokace, ale zbývají další fáze". Není to chyba:
  /// běh naváže tam, kde skončil, jakmile se klient znovu zeptá na stav.
  status         String    @default("queued")
  region         String
  industry       String
  /// Kolik firem vrátily zdroje, než začalo ověřování. U hledání po fázích se přičítá.
  foundCount     Int       @default(0)
  /// Strop z plánu uživatele — kolik firem má hledání dohromady přinést. Musí být oddělený
  /// od `foundCount`, jinak by navazující běh četl jako limit počet dosud nalezených firem.
  targetCount    Int       @default(500)
  /// Kolik fází je hotových; zároveň index té, která je na řadě. Jedna fáze = jedno město.
  stageIndex     Int       @default(0)
  /// Kolik fází má hledání celkem. 1 u běžného hledání, 14 u „Celá ČR".
  stageCount     Int       @default(1)
  /// Jméno města, ve kterém se právě hledá. Jen pro průběh v UI.
  stageLabel     String?
  /// Kolik placených dotazů do vyhledávače už tohle hledání položilo — přes všechny fáze
  /// i navazující běhy. Strop je `MAX_WEB_SEARCHES` v search-job.ts.
  webSearchCount Int       @default(0)
  /// Kolik jich je už zapsaných v databázi.
  processedCount Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Proč to spadlo. Ukazuje se uživateli, takže žádné stacktrace.
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model BusinessResult {
  id            String   @id @default(cuid())
  searchId      String
  placeId       String
  name          String
  phone         String?
  email         String?
  address       String?
  /// Souřadnice firmy, když je zdroj uvedl. Dnes je má jen OpenStreetMap; ARES vrací adresu
  /// textem, ale spolu s ní i kód adresního místa RÚIAN (viz `ruianCode`), ze kterého se
  /// souřadnice dají doplnit z otevřených dat ČÚZK — zadarmo a bez geokódování.
  lat           Float?
  lon           Float?
  /// Kód adresního místa v RÚIAN. ARES ho vrací u 97 % subjektů. Ukládáme ho i bez souřadnic,
  /// aby se daly doplnit později bez opakovaného dotazu do rejstříku.
  ruianCode     Int?
  website       String?
  // Czech company registration number. Present only for registry-sourced rows.
  ico           String?
  // Entry date from ARES. NULL for rows that never matched a registry record.
  foundedAt     DateTime?
  // From the VAT register. NULL means we never asked, not that the answer was no.
  vatPayer      Boolean?
  vatUnreliable Boolean?
  /// Kód právní formy z ARESu (112 = s.r.o., 101 = živnostník, 121 = a.s. …). Ukládá se kód,
  /// ne přeložený název — číselník patří do zobrazovací vrstvy.
  legalForm     String?
  /// Kódy CZ-NACE z ARESu (`czNace`), všechny, ne jen první. Do 13. 9. 2026 se četly a zahazovaly.
  nace          String[] @default([])
  /// Živnosti z RŽP: `[{ kind, subject, since }]` — druh, předmět podnikání, datum vzniku oprávnění.
  trades        Json?
  /// Kategorie počtu pracovníků z RES (číselník ČSÚ: 110 bez zaměstnanců, 120 = 1–5 …).
  /// `000` a NULL znamenají „neuvedeno" — třetí stav, nikdy ne nula.
  employeeCategory String?
  /// ARES `seznamRegistraci.stavZdrojeIr`: TRUE = subjekt je v insolvenčním rejstříku,
  /// FALSE = není, NULL = neptali jsme se. Jen negativní filtr; podrobnosti neukládáme.
  inInsolvency  Boolean?
  /// ARES `datumAktualizace` — kdy se záznam v rejstříku naposledy změnil.
  registryUpdatedAt DateTime?
  /// Počet provozoven s aktivním živnostenským oprávněním. Nejlepší volně dostupný signál, že
  /// firma opravdu funguje: kdo měl provozovny a všechny zrušil, skoro jistě skončil. NULL
  /// znamená, že jsme se nezeptali (firma bez IČO nebo nestihnutý dotaz), 0 je odpověď.
  activePremises Int?
  hasWebsite    Boolean  @default(false)
  // NULL on rows written before three-state classification existed; readers fall back to hasWebsite.
  websiteStatus String?
  websiteEvidence String @default("")
  hasFacebook   Boolean  @default(false)
  hasInstagram  Boolean  @default(false)
  hasLinkedIn   Boolean  @default(false)
  // Whether the three flags above are an answer at all. Social links are only ever read off the
  // firm's own homepage, so on a row where we found no page they are all false for the sole
  // reason that nobody looked — and the UI used to print that as "Bez soc. sítí". Defaults to
  // false, which reads older rows as unchecked: the honest way round.
  socialsChecked Boolean @default(false)
  // The firm's own "Kontakt" page, taken from the link on its site. The shortest path from a
  // result to an actual conversation, and usually the only page carrying a person's name.
  contactUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  linkedInUrl   String?
  websiteIsOld  Boolean  @default(false)
  websiteScore  Int      @default(50)
  websiteAgeNote String  @default("")
  // How good a sales opportunity this lead is, 0-100. See src/lib/lead-score.ts.
  leadScore     Int      @default(0)
  reviewCount   Int      @default(0)
  rating        Float?
  googleMapsUrl String?
  category      String?
  source        String   @default("google")
  rawData       Json?
  createdAt     DateTime @default(now())

  search  Search        @relation(fields: [searchId], references: [id], onDelete: Cascade)
  savedBy SavedResult[]
  tags    LeadTag[]
}

model InviteCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  note                  String?
  createdBy             String
  usedBy                String?
  usedAt                DateTime?
  expiresAt             DateTime?
  accessDurationMinutes Int?
  createdAt             DateTime  @default(now())

  creator    User  @relation("CreatedCodes", fields: [createdBy], references: [id], onDelete: Cascade)
  usedByUser User? @relation("UsedCode",    fields: [usedBy],    references: [id], onDelete: SetNull)
}

model SavedResult {
  id               String   @id @default(cuid())
  userId           String
  businessResultId String
  note             String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessResult BusinessResult @relation(fields: [businessResultId], references: [id], onDelete: Cascade)

  @@unique([userId, businessResultId])
}

/// Kolikrát z jedné (hashované) IP adresy přišel drahý anonymní požadavek.
///
/// Hledání stojí dotaz do ARESu, dotaz na Overpass a stovky DNS a HTTP requestů na cizí weby.
/// Pro přihlášené to hlídá strop v `/api/search` počítaný z tabulky Search, jenže anonym žádné
/// hledání neukládá — nemá k čemu ho přiřadit. Tohle je jeho obdoba.
///
/// Ukládá se jen SHA-256 z IP a soli, nikdy IP samotná, a záznamy se mažou po 24 hodinách.
/// I tak je to podle GDPR osobní údaj (hash je pseudonymizace, ne anonymizace), takže je
/// popsaný v Ochraně údajů.
model AnonymousHit {
  id        String   @id @default(cuid())
  ipHash    String
  /// `search` nebo `register` — jedna tabulka, dva různé stropy.
  kind      String
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
  @@index([createdAt])
}

/// Kde je uživatel s danou firmou.
///
/// Patří uživateli, ne firmě: dva lidé můžou mít tutéž firmu v úplně jiné fázi a ani jeden
/// z nich nemá co vidět stav toho druhého. Proto to není sloupec v `BusinessResult`.
///
/// `status` je volný řetězec kontrolovaný v aplikaci (`LEAD_STATUSES`), ne enum v databázi —
/// přidání šestého stavu by jinak znamenalo migraci schématu kvůli jednomu slovu.
/// Nárok na firmu: uživatel ji reálně oslovil (značka contacted / talking / client).
///
/// Zobrazení ve výsledku ani export nárok nezakládají — export celého hledání by na 30 dní
/// zabral 500 firem a druhému platícímu odsunul celý výsledek. Zakládá ho každý přihlášený účet
/// (aby po free uživateli zůstala stopa), **aplikuje se jen platícím**: cizí nárok mladší než
/// `CLAIM_TTL_DAYS` sníží skóre o `CLAIM_PENALTY` (lib/claims.ts) a dá řádku štítek bez údaje,
/// čí nárok to je. Vlastní nárok skóre nemění.
model Claim {
  id        String   @id @default(cuid())
  /// IČO, nebo `osm:<placeId>` u firem bez IČO — viz `firmKeyOf` v lib/claim-order.ts.
  firmKey   String
  userId    String
  /// Zatím jen `tag`. Místo pro další zdroje, až budou (export vybraných řádků).
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Další označení téže firmy týmž uživatelem jen obnoví čas, nezaloží druhý řádek.
  @@unique([firmKey, userId])
  @@index([firmKey, createdAt])
}

/// Trvalé vyřazení subjektu na jeho žádost.
///
/// Žádost vyřadí subjekt OKAMŽITĚ (status `active`): od zápisu se nezobrazuje nikomu, nezapisuje
/// se do nových hledání a nejde exportovat. Ověření přijde až potom — kdyby se žádost ukázala jako
/// neplatná, admin ji označí `rejected` a subjekt se vrátí. Opačné pořadí by znamenalo, že žádost
/// visí, dokud si ji někdo nepřečte, a to se u práva na námitku nedělá.
/// Index ekonomických subjektů z otevřených dat ČSÚ (RES, CC BY 4.0) — jen aktivní subjekty se
/// vznikem v posledních `REGISTRY_INDEX_MONTHS` měsících (lib/registry-index.ts).
///
/// Schválně jen registrová pole: IČO, data, právní forma, NACE, kategorie zaměstnanců a kódy
/// okresu a obce. **Žádná jména ani adresy** — 1,9 mil. řádků v dumpu jsou fyzické osoby. Index
/// říká, KOHO dohledat v ARESu; jméno a kontakt se stáhnou až u těch pár set firem, které projdou
/// filtrem. Minimalizace dat, a zároveň desetkrát menší tabulka.
model RegistrySubject {
  ico              String   @id
  foundedAt        DateTime
  /// Právní forma (číselník ČSÚ = stejné kódy jako ARES: 101 živnostník, 112 s.r.o. …).
  legalForm        String
  /// Převažující CZ-NACE (RES `NACE`), 5 znaků.
  nace             String?
  /// Kategorie počtu pracovníků (KATPO); `000` = neuvedeno.
  employeeCategory String?
  /// Okres sídla jako LAU1 (`CZ0724`); kraj = prvních 5 znaků (`CZ072`).
  district         String
  /// Kód základní územní jednotky (obec), ICZUJ.
  municipality     Int?
  /// Poslední aktualizace záznamu v RES (DDATPAKT).
  registryUpdatedAt DateTime?
  /// Který import řádek naposledy viděl. Co běh nepotvrdí, se po jeho dokončení smaže.
  importedAt       DateTime
  /// Kdy jsme firmu poprvé viděli v denní dávce změn z ARESu (etapa 4). NULL = přišla až
  /// z dumpu ČSÚ. Podle toho se pozná „nová od včera" dřív, než ji má ČSÚ ve svém souboru.
  firstSeenAt      DateTime?

  @@index([district, foundedAt])
  @@index([firstSeenAt])
  @@index([nace, foundedAt])
  @@index([importedAt])
}

/// Zpracované denní dávky změn z ARESu (etapa 4). Jeden řádek na dávku, aby se žádná
/// nezpracovala dvakrát a bylo vidět, kde synchronizace stojí.
model RegistryFeedBatch {
  /// `ros` — Registr osob (vznik a zánik subjektů). Jiné zdroje zatím nečteme.
  source      String
  batchNo     Int
  releasedAt  DateTime
  inserted    Int      @default(0)
  deleted     Int      @default(0)
  processedAt DateTime @default(now())

  @@id([source, batchNo])
}

/// Průběh importu RES: jeden řádek na běh. Dump je řazený podle IČO, takže přerušený běh
/// naváže od `cursorIco`.
model RegistryImport {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// `running` | `done` | `failed`
  status      String    @default("running")
  /// Poslední zapsané IČO — odkud navázat po vypršení funkce.
  cursorIco   String?
  /// Kolik řádků dumpu běh přečetl a kolik jich splnilo okno.
  scanned     Int       @default(0)
  kept        Int       @default(0)
  /// Datum snímku (Last-Modified souboru ČSÚ).
  snapshotAt  DateTime?
  error       String?

  @@index([startedAt])
}

model Optout {
  id          String    @id @default(cuid())
  /// IČO, nebo `osm:<placeId>` — stejný klíč jako u nároků (lib/claim-order.ts).
  firmKey     String    @unique
  /// E-mail žadatele, nepovinný — jen abychom se mohli ozvat, kdyby žádost byla nejasná.
  /// Vyřazení na něm nezávisí. Nikde se nezobrazuje.
  email       String?
  /// Jednorázový token pro potvrzovací odkaz.
  token       String    @unique
  /// `active` (platí hned) | `confirmed` (žadatel klikl na odkaz) | `rejected` (neplatná žádost, subjekt vrácen)
  status      String    @default("active")
  note        String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  reviewedAt  DateTime?

  @@index([status])
}

model LeadTag {
  id               String   @id @default(cuid())
  userId           String
  businessResultId String
  /// `new` | `contacted` | `talking` | `client` | `rejected`
  status           String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business BusinessResult @relation(fields: [businessResultId], references: [id], onDelete: Cascade)

  @@unique([userId, businessResultId])
  @@index([userId, status])
}

/// Události ze Stripe, které už webhook zpracoval.
///
/// Stripe doručuje nejméně jednou, takže tutéž událost pošle klidně třikrát — při timeoutu,
/// při našem 500, nebo prostě proto. Handler sice zapisuje stav absolutně a dvojí doručení by
/// mu nevadilo, jenže to platí jen pro zápisy do `User`. Jakmile přibude cokoli, co se dělá
/// jednou (e-mail, faktura, kredit), musí existovat místo, kde je vidět, že už se to stalo.
/// Řádek se zakládá dřív, než se událost začne zpracovávat: podruhé neprojde přes primární klíč.
model StripeEvent {
  /// `evt_…` přímo od Stripe.
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// Platba, ke které se nenašel účet.
///
/// Stát se to může jediným způsobem: platba nevznikla přes Checkout v aplikaci (ta zákazníka
/// zakládá i s `userId` v metadatech), ale přes odkaz Payment Link nebo ručně v dashboardu.
/// Fronta k ručnímu spárování — zaplacené a nepřiřazené peníze nesmí skončit jako řádek v logu,
/// který za týden nikdo nenajde.
model UnmatchedPayment {
  id                   String   @id @default(cuid())
  stripeCustomerId     String
  stripeSubscriptionId String?
  email                String?
  note                 String?
  createdAt            DateTime @default(now())
  /// Vyřešeno ručně — účet spárován, nebo peníze vráceny.
  resolvedAt           DateTime?

  @@index([createdAt])
}

/// Jeden placený dotaz do vyhledávače (Brave Search API).
///
/// Z počtu řádků za posledních 31 dní se hlídá tvrdý měsíční strop, aby provoz nikdy nepřekročil
/// bezplatný kredit — viz src/lib/web-search-quota.ts. Neúspěšný dotaz (Brave ho neúčtuje) se smaže.
model WebSearchCall {
  id String   @id @default(cuid())
  at DateTime @default(now())

  @@index([at])
}
