generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  plan             Plan      @default(FREE)
  isAdmin          Boolean   @default(false)
  isVip            Boolean   @default(false)
  accessExpiresAt  DateTime?
  stripeCustomerId String?
  // Sloupce `brevoApiKey` a `brevoSenderEmail` byly odstraněny. Aplikace přestala odesílat
  // poštu ve Vlně 2, takže se od té doby jen držel cizí API klíč, který nic nedělal —
  // to je porušení minimalizace údajů (čl. 5 odst. 1 písm. c) GDPR) a zbytečné riziko.

  // ── Onboarding profile ────────────────────────────────────────────────────
  // What the user sells, who they sell it to and where. Collected once after
  // registration so every later visit is one click, and used to rank results:
  // see targetFilters below and src/lib/lead-score.ts.
  //
  // An id from PROFESSIONS in src/lib/profile.ts, or 'other'.
  profession       String?
  // Free text, the only thing we have when profession is 'other'.
  professionText   String?
  // The trade of the firms they are looking for — feeds the search query.
  targetIndustry   String?
  targetRegion     String?
  targetCity       String?
  // Ids from LEAD_FILTERS. The share of these a firm meets is its score, so an
  // empty list is meaningful: it means "score by the neutral default".
  targetFilters    String[] @default([])
  // Set once the modal has been answered *or* skipped, so we never nag twice.
  onboardedAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  searches         Search[]
  jobs             SearchJob[]
  leadTags         LeadTag[]
  savedResults     SavedResult[]
  createdCodes     InviteCode[] @relation("CreatedCodes")
  usedCode         InviteCode[] @relation("UsedCode")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

model Search {
  id        String   @id @default(cuid())
  userId    String
  query     String
  region    String
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  results BusinessResult[]
  job     SearchJob?
}

/// Jedno hledání běžící na pozadí.
///
/// Do teď se hledání odbývalo v jednom HTTP požadavku: uživatel čekal 50 sekund s otevřenou
/// kartou a když ji zavřel, přišel o všechno. Tenhle řádek je to, co po požadavku zůstane —
/// route ho založí, vrátí jeho id a práce pokračuje mimo odpověď (`waitUntil`).
///
/// Počítadla se aktualizují průběžně, po dávkách, ne až na konci. Když job spadne v půlce,
/// zapsané firmy zůstanou a `error` řekne proč — což je celý smysl toho, že tu ta tabulka je.
model SearchJob {
  id             String    @id @default(cuid())
  userId         String
  /// Hledání, do kterého se zapisují výsledky. Zakládá se rovnou s jobem, aby export fungoval
  /// i nad rozpracovaným během.
  searchId       String    @unique
  /// `queued` | `running` | `paused` | `done` | `failed`
  ///
  /// `paused` znamená „došel čas jedné invokace, ale zbývají další fáze". Není to chyba:
  /// běh naváže tam, kde skončil, jakmile se klient znovu zeptá na stav.
  status         String    @default("queued")
  region         String
  industry       String
  /// Kolik firem vrátily zdroje, než začalo ověřování. U hledání po fázích se přičítá.
  foundCount     Int       @default(0)
  /// Strop z plánu uživatele — kolik firem má hledání dohromady přinést. Musí být oddělený
  /// od `foundCount`, jinak by navazující běh četl jako limit počet dosud nalezených firem.
  targetCount    Int       @default(500)
  /// Kolik fází je hotových; zároveň index té, která je na řadě. Jedna fáze = jedno město.
  stageIndex     Int       @default(0)
  /// Kolik fází má hledání celkem. 1 u běžného hledání, 14 u „Celá ČR".
  stageCount     Int       @default(1)
  /// Jméno města, ve kterém se právě hledá. Jen pro průběh v UI.
  stageLabel     String?
  /// Kolik jich je už zapsaných v databázi.
  processedCount Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Proč to spadlo. Ukazuje se uživateli, takže žádné stacktrace.
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model BusinessResult {
  id            String   @id @default(cuid())
  searchId      String
  placeId       String
  name          String
  phone         String?
  email         String?
  address       String?
  /// Souřadnice firmy, když je zdroj uvedl. Dnes je má jen OpenStreetMap; ARES vrací adresu
  /// textem, ale spolu s ní i kód adresního místa RÚIAN (viz `ruianCode`), ze kterého se
  /// souřadnice dají doplnit z otevřených dat ČÚZK — zadarmo a bez geokódování.
  lat           Float?
  lon           Float?
  /// Kód adresního místa v RÚIAN. ARES ho vrací u 97 % subjektů. Ukládáme ho i bez souřadnic,
  /// aby se daly doplnit později bez opakovaného dotazu do rejstříku.
  ruianCode     Int?
  website       String?
  // Czech company registration number. Present only for registry-sourced rows.
  ico           String?
  // Entry date from ARES. NULL for rows that never matched a registry record.
  foundedAt     DateTime?
  // From the VAT register. NULL means we never asked, not that the answer was no.
  vatPayer      Boolean?
  vatUnreliable Boolean?
  /// Kód právní formy z ARESu (112 = s.r.o., 101 = živnostník, 121 = a.s. …). Ukládá se kód,
  /// ne přeložený název — číselník patří do zobrazovací vrstvy.
  legalForm     String?
  /// Počet provozoven s aktivním živnostenským oprávněním. Nejlepší volně dostupný signál, že
  /// firma opravdu funguje: kdo měl provozovny a všechny zrušil, skoro jistě skončil. NULL
  /// znamená, že jsme se nezeptali (firma bez IČO nebo nestihnutý dotaz), 0 je odpověď.
  activePremises Int?
  hasWebsite    Boolean  @default(false)
  // NULL on rows written before three-state classification existed; readers fall back to hasWebsite.
  websiteStatus String?
  websiteEvidence String @default("")
  hasFacebook   Boolean  @default(false)
  hasInstagram  Boolean  @default(false)
  hasLinkedIn   Boolean  @default(false)
  // Whether the three flags above are an answer at all. Social links are only ever read off the
  // firm's own homepage, so on a row where we found no page they are all false for the sole
  // reason that nobody looked — and the UI used to print that as "Bez soc. sítí". Defaults to
  // false, which reads older rows as unchecked: the honest way round.
  socialsChecked Boolean @default(false)
  // The firm's own "Kontakt" page, taken from the link on its site. The shortest path from a
  // result to an actual conversation, and usually the only page carrying a person's name.
  contactUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  linkedInUrl   String?
  websiteIsOld  Boolean  @default(false)
  websiteScore  Int      @default(50)
  websiteAgeNote String  @default("")
  // How good a sales opportunity this lead is, 0-100. See src/lib/lead-score.ts.
  leadScore     Int      @default(0)
  reviewCount   Int      @default(0)
  rating        Float?
  googleMapsUrl String?
  category      String?
  source        String   @default("google")
  rawData       Json?
  createdAt     DateTime @default(now())

  search  Search        @relation(fields: [searchId], references: [id], onDelete: Cascade)
  savedBy SavedResult[]
  tags    LeadTag[]
}

model InviteCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  note                  String?
  createdBy             String
  usedBy                String?
  usedAt                DateTime?
  expiresAt             DateTime?
  accessDurationMinutes Int?
  createdAt             DateTime  @default(now())

  creator    User  @relation("CreatedCodes", fields: [createdBy], references: [id], onDelete: Cascade)
  usedByUser User? @relation("UsedCode",    fields: [usedBy],    references: [id], onDelete: SetNull)
}

model SavedResult {
  id               String   @id @default(cuid())
  userId           String
  businessResultId String
  note             String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessResult BusinessResult @relation(fields: [businessResultId], references: [id], onDelete: Cascade)

  @@unique([userId, businessResultId])
}

/// Kolikrát z jedné (hashované) IP adresy přišel drahý anonymní požadavek.
///
/// Hledání stojí dotaz do ARESu, dotaz na Overpass a stovky DNS a HTTP requestů na cizí weby.
/// Pro přihlášené to hlídá strop v `/api/search` počítaný z tabulky Search, jenže anonym žádné
/// hledání neukládá — nemá k čemu ho přiřadit. Tohle je jeho obdoba.
///
/// Ukládá se jen SHA-256 z IP a soli, nikdy IP samotná, a záznamy se mažou po 24 hodinách.
/// I tak je to podle GDPR osobní údaj (hash je pseudonymizace, ne anonymizace), takže je
/// popsaný v Ochraně údajů.
model AnonymousHit {
  id        String   @id @default(cuid())
  ipHash    String
  /// `search` nebo `register` — jedna tabulka, dva různé stropy.
  kind      String
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
  @@index([createdAt])
}

/// Kde je uživatel s danou firmou.
///
/// Patří uživateli, ne firmě: dva lidé můžou mít tutéž firmu v úplně jiné fázi a ani jeden
/// z nich nemá co vidět stav toho druhého. Proto to není sloupec v `BusinessResult`.
///
/// `status` je volný řetězec kontrolovaný v aplikaci (`LEAD_STATUSES`), ne enum v databázi —
/// přidání šestého stavu by jinak znamenalo migraci schématu kvůli jednomu slovu.
model LeadTag {
  id               String   @id @default(cuid())
  userId           String
  businessResultId String
  /// `new` | `contacted` | `talking` | `client` | `rejected`
  status           String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business BusinessResult @relation(fields: [businessResultId], references: [id], onDelete: Cascade)

  @@unique([userId, businessResultId])
  @@index([userId, status])
}
